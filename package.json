{
  "name": "dsh-plugin-endnote-cwyw",
  "version": "0.1.0",
  "description": "Extend a partially cited Word manuscript from PDFs and an existing EndNote library, with editable citations and an audited library copy.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Spark-xY6/dsh-plugin-endnote-cwyw.git" },
  "homepage": "https://github.com/Spark-xY6/dsh-plugin-endnote-cwyw#readme",
  "bugs": { "url": "https://github.com/Spark-xY6/dsh-plugin-endnote-cwyw/issues" },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "keywords": ["dsh-plugin", "deepseek-harness", "endnote", "cwyw", "citations", "word"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.5" },
  "scripts": {
    "test": "node --test tests/dsh.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5"
  },
  "files": [
    "index.js", "cordis.patch.yml", "icon.svg", "locale/*.json", "requirements.txt",
    "skills/*/SKILL.md", "skills/*/scripts/*.py", "skills/*/references/*.md",
    "README.md", "README.zh.md", "docs/*.md", "docs/*.html", "docs/evaluation.json",
    "examples/seed.md", "examples/plan.json", "CONTRIBUTING.md", "SECURITY.md", "LICENSE"
  ]
}
